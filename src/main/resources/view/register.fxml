<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import java.net.URL?>
<VBox styleClass="register-container" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://fxml.com/fxml/1" fx:controller="org.example.controller.RegisterController">
    <stylesheets>
        <URL value="@../styles/Register.css" />
    </stylesheets>


    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Registro de Usuario" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="txtNombre" promptText="Nombre"/>
    <TextField fx:id="txtApellidos" promptText="Apellidos"/>
    <TextField fx:id="txtCorreo" promptText="Correo Electrónico"/>
    <PasswordField fx:id="txtContrasenia" promptText="Contraseña"/>

    <Button text="Registrarse" onAction="#handleRegister" styleClass="btn-submit-reg"/>
    <Label fx:id="lblMensaje" text="" style="-fx-text-fill: red;"/>
</VBox>