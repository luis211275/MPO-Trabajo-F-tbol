<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://www.w3.org/fxml"

      stylesheets="/styles/Main.css"
      fx:controller="org.example.controller.JugadorController"
      spacing="10"
      alignment="CENTER"
      styleClass="container">


        <HBox alignment="TOP_RIGHT" spacing="10.0" style="-fx-background-color: #2c3e50; -fx-padding: 10px;">
            <Button text="Iniciar Sesión" onAction="#mostrarLogin" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Registrarse" onAction="#mostrarRegister" style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>


    <TextField fx:id="txtNombre" promptText="Nombre"/>
    <TextField fx:id="txtApellido" promptText="Apellido"/>
    <TextField fx:id="txtGoles" promptText="Goles"/>
    <TextField fx:id="txtAsistencias" promptText="Asistencias"/>


    <Button text="Enviar" onAction="#sendData"/>


    <TableView fx:id="tablaJugador" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colNombre" text="Nombre"/>
            <TableColumn fx:id="colApellido" text="Apellido"/>
            <TableColumn fx:id="colGoles" text="Goles"/>
            <TableColumn fx:id="colAsistencias" text="Asistencias"/>
        </columns>
    </TableView>

</VBox>