<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import java.net.URL?>
<VBox styleClass="login-container" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://fxml.com/fxml/1" fx:controller="org.example.controller.LoginController">

    <stylesheets>
        <URL value="@../styles/Login.css" />
    </stylesheets>


    <HBox alignment="CENTER" spacing="5.0">
        <Label text="¿No tienes cuenta?" />
        <Hyperlink text="Regístrate aquí" onAction="#irARegistroDesdeLogin" style="-fx-text-fill: #28a745;"/>
    </HBox>


    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Inicio de Sesión" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TextField fx:id="txtCorreo" promptText="Correo Electrónico"/>
    <PasswordField fx:id="txtContrasenia" promptText="Contraseña"/>

    <Button text="Iniciar Sesión" onAction="#handleLogin" style="-fx-background-color: #007bff; -fx-text-fill: white;"/>
    <Label fx:id="lblMensaje" text="" style="-fx-text-fill: red;"/>
</VBox>